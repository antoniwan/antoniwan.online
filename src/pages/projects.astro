---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import { SITE } from '../config/site';
import { projects } from '../data/projects';
---

<Base
  title="Projects"
  description="Everything Antonio Rodríguez Martínez built and keeps running: Notes, his company's site, Skincare for You, Panda and Wolf, two bilingual picture books, LinksForest, and this site."
>
  <section class="hero">
    <div>
      <span class="eyebrow">Projects</span>
      <h1>Things I built and keep</h1>
      <p class="hero__intro">
        Small web things, mostly for my family and myself, and the sites I run. The code is on{' '}
        <a href="https://github.com/antoniwan" rel="me">GitHub</a>. Client work and consulting live with{' '}
        <a href={SITE.company.consultingUrl}>my company</a>.
      </p>
    </div>
  </section>

  <Seam />

  <section class="section" id="projects" aria-label="Projects">
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h3>
              <a href={project.href}>{project.title}</a>
            </h3>
            <p>{project.body}</p>
            <p class="project__meta">
              {project.stack}
              {project.repo && (
                <>
                  {' · '}
                  <a href={project.repo}>Source</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
