---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import { SITE } from '../config/site';
import { projects, workForOthers } from '../data/projects';
---

<Base
  title="Projects"
  description="Things Antonio Rodríguez Martínez has built: Notes, his company's site, Skincare for You, Panda and Wolf, two bilingual picture books, LinksForest, this site, and work for others."
>
  <section class="hero">
    <div>
      <span class="eyebrow">Projects</span>
      <h1>Things I've built</h1>
      <p class="hero__intro">
        I like starting things. Once one is built, I hand it to someone and go build the next idea. Most
        of the code is on <a href="https://github.com/antoniwan" rel="me">GitHub</a>. New client work and
        consulting go through <a href={SITE.company.consultingUrl}>my company</a>.
      </p>
    </div>
  </section>

  <Seam />

  <section class="section" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">My own</h2>
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h3>
              <a href={project.href}>{project.title}</a>
            </h3>
            <p>{project.body}</p>
            <p class="project__meta">
              {project.stack}
              {project.repo && (
                <>
                  {' · '}
                  <a href={project.repo}>Source</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <Seam />

  <section class="section" id="work-for-others" aria-labelledby="work-for-others-title">
    <h2 id="work-for-others-title">For others</h2>
    <ul class="projects">
      {
        workForOthers.map((entry) => (
          <li class="project project--text">
            <h3>{entry.title}</h3>
            <p>{entry.body}</p>
            <p class="project__meta">{entry.context}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
