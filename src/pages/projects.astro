---
import { cta } from '../utils/cta';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../config/site';
import Ledger from '../components/Ledger.astro';
import ProjectArt from '../components/ProjectArt.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import { projects, workForOthers, type Project } from '../data/projects';

// Structured data for "My own" only. Work for others belonged to employers and clients, so it is left out.
// Every fact below comes from the card in src/data/projects.ts; nothing is added that the card does not say.
const author = { '@id': SITE.personId };
const company = { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url };
const featured = projects.filter(project => project.featured);
const others = projects.filter(project => !project.featured);
// One wide tile leads, the games and the app sit on a shelf of equals, and the picture books follow as small tiles.
const isBook = (project: Project) => project.featured?.art === 'sky' || project.featured?.art === 'line';
const lead = featured.find(project => project.featured?.lead);
const shelf = featured.filter(project => project !== lead && !isBook(project));
const books = featured.filter(isBook);
// The schema.org type and the facts the card states beyond its title, link and text.
const schemaByTitle: Record<string, Record<string, unknown>> = {
  'Cookbook': { '@type': 'WebSite', inLanguage: ['en', 'es'] },
  'Unblinking': { '@type': 'SoftwareApplication', applicationCategory: 'DesktopEnhancementApplication', operatingSystem: 'Windows', isAccessibleForFree: true, image: `${SITE.url}/projects/unblinking.webp` },
  'The Object': { '@type': 'VideoGame', gamePlatform: 'Web browser', genre: 'Art game', isAccessibleForFree: true, image: `${SITE.url}/projects/the-object.webp` },
  'Lifesworn': { '@type': 'VideoGame' },
  'Uplift': { '@type': 'VideoGame', gamePlatform: 'Web browser', publisher: company },
  // The same @id as the WebSite node Base emits on Home, so both describe one site.
  'antoniwan.online': { '@type': 'WebSite', '@id': `${SITE.url}/#website` },
  'Strong Hands, Soft Heart': { '@type': 'WebSite', publisher: company },
  'Panda and Wolf': { '@type': 'CreativeWork' },
  'The Bent One': { '@type': 'Book', publisher: company },
  'Notes': { '@type': 'Blog', inLanguage: ['en', 'es'] },
  'Mia, the Sun, and the Moon': { '@type': 'Book', publisher: company },
};
const listId = `${SITE.url}/projects#my-own`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': listId,
  name: "Antonio's own projects",
  numberOfItems: projects.length,
  itemListElement: [...(lead ? [lead] : []), ...shelf, ...books, ...others].map((project, index) => {
    const anchor = project.featured?.id;
    const facts = schemaByTitle[project.title] ?? { '@type': 'CreativeWork' };
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        ...facts,
        ...(anchor ? { '@id': `${SITE.url}/projects#${anchor}` } : {}),
        name: project.title,
        url: project.href.startsWith('/') ? SITE.url + project.href : project.href,
        description: project.body,
        ...(project.alsoOn ? { sameAs: project.alsoOn.map(place => place.href) } : {}),
        author,
      },
    };
  }),
};
---

<Base
  title="Projects"
  description="Projects by Antonio Rodríguez Martínez: his games, a desktop companion, and picture books first, then apps, tools and websites, and work for others."
  mainEntity={listId}
>
  <PageIntro label="Projects" title="Things I've built">
    Things I build for myself, for others, and for the fun of it. Most of the code is on
    <a href="https://github.com/antoniwan" rel="me">GitHub</a>. Client work and consulting go through
    <a href={SITE.company.consultingUrl} {...cta('consulting')}>my company</a>.
  </PageIntro>

  <section class="section project-showcase" id="projects" aria-labelledby="projects-title">
    <div class="project-section-heading">
      <h2 id="projects-title">My own</h2>
      <a class="project-history-link" href="#work-for-others">Work &amp; experiments ↓</a>
    </div>

    {lead && (
      <article class="project project--lead" id={lead.featured?.id}>
        {lead.featured?.art === 'logo' ? (
            <h3 class="project__frame-title"><a class="project__frame" href={lead.href}><ProjectArt project={lead} /></a></h3>
          ) : (
            <a class="project__frame" href={lead.href} tabindex="-1" aria-hidden="true"><ProjectArt project={lead} /></a>
          )}
        <div class="project__text">
          <p class="project__label">The big one</p>
          {lead.featured?.art !== 'logo' && <h3><a href={lead.href}>{lead.title}</a></h3>}
          <p class="project__line">{lead.featured?.line}</p>
          <p class="project__body">{lead.body}</p>
          <p class="project__action"><a class="button" href={lead.href} {...cta(`project-${lead.featured?.id}`)}>{lead.featured?.action}</a></p>
          <ProjectMeta project={lead} />
        </div>
      </article>
    )}

    <ul class="project-shelf" aria-label="Games and apps">
      {shelf.map(project => (
        <li class="project project--shelf" id={project.featured?.id}>
          {project.featured?.art === 'logo' ? (
            <h3 class="project__frame-title"><a class="project__frame" href={project.href}><ProjectArt project={project} /></a></h3>
          ) : (
            <a class="project__frame" href={project.href} tabindex="-1" aria-hidden="true"><ProjectArt project={project} /></a>
          )}
          <div class="project__text">
            {project.featured?.art !== 'logo' && <h3><a href={project.href}>{project.title}</a></h3>}
            <p class="project__line">{project.featured?.line}</p>
            <p class="project__body project__body--short">{project.body}</p>
            <p class="project__action"><a class="button" href={project.href} {...cta(`project-${project.featured?.id}`)}>{project.featured?.action}</a></p>
            <ProjectMeta project={project} />
          </div>
        </li>
      ))}
    </ul>

    <ul class="project-books" aria-label="Picture books">
      {books.map(project => (
        <li class="project project--book" id={project.featured?.id}>
          <ProjectArt project={project} />
          <div class="project__text">
            <h3><a href={project.href}>{project.title}</a></h3>
            <p class="project__line">{project.featured?.line}</p>
            <p class="project__body">{project.body}</p>
            <p class="project__action"><a class="button" href={project.href} {...cta(`project-${project.featured?.id}`)}>{project.featured?.action}</a></p>
            <ProjectMeta project={project} />
          </div>
        </li>
      ))}
    </ul>

    <h2 class="project-more-title">Also made</h2>
    <ul class="project-rows">
      {others.map(project => (
        <li class="project-row">
          <h3><a href={project.href}>{project.title}</a></h3>
          <p>{project.body}</p>
          <ProjectMeta project={project} />
        </li>
      ))}
    </ul>
  </section>

  <section class="project-category project-history" id="work-for-others" aria-labelledby="work-for-others-title">
    <div class="project-category__heading">
      <h2 id="work-for-others-title">Work &amp; experiments</h2>
      <p>Jobs, side work, favors, and ideas I followed for a while.</p>
    </div>
    <div class="section__body">
      <Ledger groups={workForOthers} />
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</Base>

