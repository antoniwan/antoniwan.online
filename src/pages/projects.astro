---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../config/site';
import Ledger from '../components/Ledger.astro';
import { projectCategories, projects, workForOthers } from '../data/projects';

// Structured data for "My own" only. Work for others belonged to employers and clients, so it is left out.
// Every fact below comes from the card in src/data/projects.ts; nothing is added that the card does not say.
const author = { '@id': SITE.personId };
const company = { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url };
const anchors: Record<string, string> = {
  'The Bent One': 'the-bent-one',
  'Mia, the Sun, and the Moon': 'mia-the-sun-and-the-moon',
};
// The schema.org type and the facts the card states beyond its title, link and text.
const schemaByTitle: Record<string, Record<string, unknown>> = {
  'Cookbook': { '@type': 'WebSite', inLanguage: ['en', 'es'] },
  'Lifesworn': { '@type': 'VideoGame' },
  'Uplift': { '@type': 'VideoGame', gamePlatform: 'Web browser', publisher: company },
  // The same @id as the WebSite node Base emits on Home, so both describe one site.
  'antoniwan.online': { '@type': 'WebSite', '@id': `${SITE.url}/#website` },
  'Strong Hands, Soft Heart': { '@type': 'WebSite', publisher: company },
  'Panda and Wolf': { '@type': 'CreativeWork' },
  'The Bent One': { '@type': 'Book', publisher: company },
  'LinksForest': { '@type': 'WebApplication' },
  'Notes': { '@type': 'Blog', inLanguage: ['en', 'es'] },
  'Mia, the Sun, and the Moon': { '@type': 'Book', publisher: company },
};
const listId = `${SITE.url}/projects#my-own`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': listId,
  name: "Antonio's own projects",
  numberOfItems: projects.length,
  itemListElement: projects.map((project, index) => {
    const anchor = anchors[project.title];
    const facts = schemaByTitle[project.title] ?? { '@type': 'CreativeWork' };
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        ...facts,
        ...(anchor ? { '@id': `${SITE.url}/projects#${anchor}` } : {}),
        name: project.title,
        url: project.href.startsWith('/') ? SITE.url + project.href : project.href,
        description: project.body,
        author,
      },
    };
  }),
};
---

<Base
  title="Projects"
  description="Projects by Antonio Rodríguez Martínez: apps and tools, games and books, websites and writing, and work for others."
  mainEntity={listId}
>
  <PageIntro label="Projects" title="Things I've built">
    Things I build for myself, for others, and for the fun of it. Most of the code is on
    <a href="https://github.com/antoniwan" rel="me">GitHub</a>. Client work and consulting go through
    <a href={SITE.company.consultingUrl}>my company</a>.
  </PageIntro>

  <section class="section project-showcase" id="projects" aria-labelledby="projects-title">
    <div class="project-section-heading">
      <h2 id="projects-title">My own</h2>
      <a class="project-history-link" href="#work-for-others">Work &amp; experiments ↓</a>
    </div>
    <div class="project-browse">
      <div class="project-filters" role="group" aria-label="Filter projects" hidden>
        <button type="button" data-project-filter="all" aria-pressed="true" aria-controls="project-list">All projects</button>
        {projectCategories.map(category => <button type="button" data-project-filter={category.id} aria-pressed="false" aria-controls="project-list">{category.title}</button>)}
      </div>
      <p id="project-results" role="status" aria-live="polite" aria-atomic="true">{projects.length} projects</p>
    </div>
    <ul class="projects" id="project-list">
      {projects.map(project => (
        <li class="project" data-category={project.category} id={project.title === 'The Bent One' ? 'the-bent-one' : project.title === 'Mia, the Sun, and the Moon' ? 'mia-the-sun-and-the-moon' : undefined}>
          <p class="project__category">{projectCategories.find(category => category.id === project.category)?.title}</p>
          {project.logo ? (
            <div class="project__head">
              <h3><a href={project.href}>{project.title}</a></h3>
              <a class="project__logo" href={project.href} target="_blank" rel="noopener">
                <img src={project.logo.src} width={project.logo.width} height={project.logo.height} alt={project.title} class:list={{ 'is-pixelated': project.logo.pixelated }} loading="lazy" decoding="async" />
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </div>
          ) : (
            <h3><a href={project.href}>{project.title}</a></h3>
          )}
          <p>{project.body}</p>
          <p class="project__meta">
            {project.stack}
            {project.repo && <>{' · '}<a href={project.repo} aria-label={`Source for ${project.title}`}>Source</a></>}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="project-category project-history" id="work-for-others" aria-labelledby="work-for-others-title">
    <div class="project-category__heading">
      <h2 id="work-for-others-title">Work &amp; experiments</h2>
      <p>Jobs, side work, favors, and ideas I followed for a while.</p>
    </div>
    <div class="section__body">
      <Ledger groups={workForOthers} />
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('.project-filters');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.project[data-category]')];
  const results = document.querySelector('#project-results');

  function filterProjects(category: string) {
    let count = 0;
    cards.forEach(card => {
      card.hidden = category !== 'all' && card.dataset.category !== category;
      if (!card.hidden) count++;
    });
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.projectFilter === category)));
    if (results) results.textContent = category === 'all' ? `${count} projects` : `${count} of ${cards.length} projects`;
  }

  function revealLinkedProject() {
    let target: HTMLElement | null;
    try { target = document.getElementById(decodeURIComponent(location.hash.slice(1))); }
    catch { return; }
    if (target?.matches('.project[hidden]')) {
      filterProjects('all');
      target.scrollIntoView({ block: 'start' });
    }
  }

  // ?category=<id> opens the list filtered, so other pages can link to one category. A click keeps the address in step.
  function setCategoryParam(category: string) {
    const url = new URL(location.href);
    if (category === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', category);
    history.replaceState(history.state, '', url);
  }

  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.projectFilter ?? 'all';
    filterProjects(category);
    setCategoryParam(category);
  }));
  window.addEventListener('hashchange', revealLinkedProject);
  if (filters) filters.hidden = false;
  const linked = new URLSearchParams(location.search).get('category');
  if (linked && buttons.some(button => button.dataset.projectFilter === linked)) filterProjects(linked);
</script>
