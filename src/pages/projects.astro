---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../config/site';
import Ledger from '../components/Ledger.astro';
import ProjectArt from '../components/ProjectArt.astro';
import { projects, workForOthers } from '../data/projects';

// Structured data for "My own" only. Work for others belonged to employers and clients, so it is left out.
// Every fact below comes from the card in src/data/projects.ts; nothing is added that the card does not say.
const author = { '@id': SITE.personId };
const company = { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url };
// The games and picture books lead as big tiles; the rest follow as a compact list.
const featured = projects.filter(project => project.featured);
const others = projects.filter(project => !project.featured);
// The schema.org type and the facts the card states beyond its title, link and text.
const schemaByTitle: Record<string, Record<string, unknown>> = {
  'Cookbook': { '@type': 'WebSite', inLanguage: ['en', 'es'] },
  'Lifesworn': { '@type': 'VideoGame' },
  'Uplift': { '@type': 'VideoGame', gamePlatform: 'Web browser', publisher: company },
  // The same @id as the WebSite node Base emits on Home, so both describe one site.
  'antoniwan.online': { '@type': 'WebSite', '@id': `${SITE.url}/#website` },
  'Strong Hands, Soft Heart': { '@type': 'WebSite', publisher: company },
  'Panda and Wolf': { '@type': 'CreativeWork' },
  'The Bent One': { '@type': 'Book', publisher: company },
  'Notes': { '@type': 'Blog', inLanguage: ['en', 'es'] },
  'Mia, the Sun, and the Moon': { '@type': 'Book', publisher: company },
};
const listId = `${SITE.url}/projects#my-own`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': listId,
  name: "Antonio's own projects",
  numberOfItems: projects.length,
  itemListElement: [...featured, ...others].map((project, index) => {
    const anchor = project.featured?.id;
    const facts = schemaByTitle[project.title] ?? { '@type': 'CreativeWork' };
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        ...facts,
        ...(anchor ? { '@id': `${SITE.url}/projects#${anchor}` } : {}),
        name: project.title,
        url: project.href.startsWith('/') ? SITE.url + project.href : project.href,
        description: project.body,
        author,
      },
    };
  }),
};
---

<Base
  title="Projects"
  description="Projects by Antonio Rodríguez Martínez: his games and picture books first, then apps, tools and websites, and work for others."
  mainEntity={listId}
>
  <PageIntro label="Projects" title="Things I've built">
    Things I build for myself, for others, and for the fun of it. Most of the code is on
    <a href="https://github.com/antoniwan" rel="me">GitHub</a>. Client work and consulting go through
    <a href={SITE.company.consultingUrl}>my company</a>.
  </PageIntro>

  <section class="section project-showcase" id="projects" aria-labelledby="projects-title">
    <div class="project-section-heading">
      <h2 id="projects-title">My own</h2>
      <a class="project-history-link" href="#work-for-others">Work &amp; experiments ↓</a>
    </div>
    <ul class="featured" id="featured" aria-label="Games and picture books">
      {featured.map(project => (
        <li class="project project--featured" id={project.featured?.id}>
          {project.featured?.art === 'logo' ? (
            <h3 class="project__art-title"><a href={project.href}><ProjectArt project={project} /></a></h3>
          ) : (
            <>
              <ProjectArt project={project} />
              <h3><a href={project.href}>{project.title}</a></h3>
            </>
          )}
          <p class="project__line">{project.featured?.line}</p>
          <p>{project.body}</p>
          <p class="project__meta">
            {project.stack}
            {project.repo && <>{' · '}<a href={project.repo} aria-label={`Source for ${project.title}`}>Source</a></>}
          </p>
        </li>
      ))}
    </ul>

    <h3 class="project-more-title">Also made</h3>
    <ul class="project-rows">
      {others.map(project => (
        <li class="project-row">
          <h4><a href={project.href}>{project.title}</a></h4>
          <p>{project.body}</p>
          <p class="project__meta">
            {project.stack}
            {project.repo && <>{' · '}<a href={project.repo} aria-label={`Source for ${project.title}`}>Source</a></>}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="project-category project-history" id="work-for-others" aria-labelledby="work-for-others-title">
    <div class="project-category__heading">
      <h2 id="work-for-others-title">Work &amp; experiments</h2>
      <p>Jobs, side work, favors, and ideas I followed for a while.</p>
    </div>
    <div class="section__body">
      <Ledger groups={workForOthers} />
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</Base>

