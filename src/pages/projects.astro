---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import { SITE } from '../config/site';
import { projects, workForOthers } from '../data/projects';
---

<Base
  title="Projects"
  description="Things Antonio Rodríguez Martínez has built: Notes, his company's site, Skincare for You, Panda and Wolf, two bilingual picture books, LinksForest, this site, and work for others."
>
  <section class="hero">
    <div>
      <span class="eyebrow">Projects</span>
      <h1>Things I've built</h1>
      <p class="hero__intro">
        I like starting things. Once one is built, I hand it to someone and go build the next idea. Most
        of the code is on <a href="https://github.com/antoniwan" rel="me">GitHub</a>. New client work and
        consulting go through <a href={SITE.company.consultingUrl}>my company</a>.
      </p>
    </div>
  </section>

  <Seam />

  <section class="section" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">My own</h2>
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h3>
              <a href={project.href}>{project.title}</a>
            </h3>
            <p>{project.body}</p>
            <p class="project__meta">
              {project.stack}
              {project.repo && (
                <>
                  {' · '}
                  <a href={project.repo}>Source</a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <Seam />

  <section class="section section--split" id="work-for-others" aria-labelledby="work-for-others-title">
    <div class="section__heading">
      <h2 id="work-for-others-title">For others</h2>
    </div>
    <div class="section__body">
      {
        workForOthers.map((group) => (
          <div class="ledger">
            <h3 class="ledger__group">{group.name}</h3>
            <ul class="ledger__entries">
              {group.entries.map((entry) => (
                <li class="ledger__entry">
                  <p class="ledger__head">
                    <span class="ledger__title">{entry.title}</span>
                    {entry.when && <span class="ledger__when">{entry.when}</span>}
                  </p>
                  <p class="ledger__body">{entry.body}</p>
                  {entry.parts && (
                    <ul class="ledger__parts">
                      {entry.parts.map((part) => (
                        <li>
                          <strong lang={part.lang}>{part.name}.</strong> {part.text}
                          {part.unfinished && <span class="ledger__tag">Unfinished</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
