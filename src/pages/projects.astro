---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../config/site';
import Ledger from '../components/Ledger.astro';
import { projectCategories, projects, workForOthers } from '../data/projects';
---

<Base
  title="Projects"
  description="Projects by Antonio Rodríguez Martínez: apps and tools, games and books, websites and writing, and work for others."
>
  <PageIntro label="Projects" title="Things I've built">
    Things I build for myself, for others, and for the fun of it. Most of the code is on
    <a href="https://github.com/antoniwan" rel="me">GitHub</a>. Client work and consulting go through
    <a href={SITE.company.consultingUrl}>my company</a>.
  </PageIntro>

  <nav class="project-nav" aria-label="Project categories">
    {projectCategories.map(category => <a href={`#${category.id}`}>{category.title}</a>)}
    <a href="#work-for-others">Work &amp; experiments</a>
  </nav>

  <div id="projects">
    {projectCategories.map(category => (
      <section class="project-category" id={category.id} aria-labelledby={`${category.id}-title`}>
        <div class="project-category__heading">
          <h2 id={`${category.id}-title`}>{category.title}</h2>
          <p>{category.description}</p>
        </div>
        <ul class="projects">
          {projects.filter(project => project.category === category.id).map(project => (
          <li class="project" id={project.title === 'The Bent One' ? 'the-bent-one' : project.title === 'Mia, the Sun, and the Moon' ? 'mia-the-sun-and-the-moon' : undefined}>
            <h3>
              <a href={project.href}>{project.title}</a>
            </h3>
            <p>{project.body}</p>
            <p class="project__meta">
              {project.stack}
              {project.repo && (
                <>
                  {' · '}
                  <a href={project.repo} aria-label={`Source for ${project.title}`}>Source</a>
                </>
              )}
            </p>
          </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="project-category project-history" id="work-for-others" aria-labelledby="work-for-others-title">
    <div class="project-category__heading">
      <h2 id="work-for-others-title">Work &amp; experiments</h2>
      <p>Jobs, side work, favors, and ideas I followed for a while.</p>
    </div>
    <div class="section__body">
      <Ledger groups={workForOthers} />
    </div>
  </section>
</Base>
