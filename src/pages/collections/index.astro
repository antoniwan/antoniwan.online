---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CollectionTabs from '../../components/CollectionTabs.astro';
import ReadingNow from '../../components/ReadingNow.astro';
import LatestWatched from '../../components/LatestWatched.astro';
import NowPlaying from '../../components/NowPlaying.astro';
import { getMovieCollection } from '../../data/movies';
import { games } from '../../data/games';
import { breadcrumbs } from '../../utils/breadcrumbs';
import { collectionsModified } from '../../utils/lastmod';
const { snapshot } = await getMovieCollection();
const byId = new Map(games.games.map(game => [game.id, game]));
const nowPlaying = games.nowPlaying.flatMap(id => byId.get(id) ?? []);
---
<Base title="Collections" description="What Antonio is reading, watching, and playing lately, with the way into his reading library, movie diary, and game log." collection breadcrumbs={breadcrumbs('Collections', '/collections')} dateModified={collectionsModified(snapshot.movies)}>
  <PageIntro label="Collections" title="Things I return to">
    Books, movies, and games: what I'm into lately, and the whole shelf behind it. These are personal catalogues, not lists of recommendations.
  </PageIntro>
  <CollectionTabs current="lately" />
  <ReadingNow seeAll />
  <LatestWatched movies={snapshot.movies} diaryUrl={`${snapshot.profileUrl}diary/`} seeAll />
  <NowPlaying games={nowPlaying} seeAll />
  <aside class="section collection-context">
    <h2>A different kind of shelf</h2>
    <p>The picture books I wrote belong with the things I've made. You'll find them in <a href="/projects#featured">Projects</a>.</p>
    <p>Our family recipes have their own home at <a href="https://cookbook.antoniwan.online/">Cookbook</a>.</p>
  </aside>
</Base>
