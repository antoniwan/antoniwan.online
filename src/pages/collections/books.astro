---
import { cta } from '../../utils/cta';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CollectionTabs from '../../components/CollectionTabs.astro';
import ReadingNow from '../../components/ReadingNow.astro';
import { books, bookLinks, readingStatusLabels } from '../../data/books';
import { SITE } from '../../config/site';
import { breadcrumbs } from '../../utils/breadcrumbs';
// No dateModified here: the books snapshot carries no date.
const parent = { label: 'Collections', href: '/collections' };
const statusCounts = Object.entries(readingStatusLabels).map(([value, label]) => ({ value, label, count: books.filter(book => book.readingStatus === value).length })).filter(status => status.count > 0);
const subjects = [...new Set(books.flatMap(book => book.subjects))].sort((first, second) => first.localeCompare(second));
const listId = `${SITE.url}/collections/books#catalogue`;
const sameAs = (id: string) => [bookLinks[id]?.wikipedia, bookLinks[id]?.wikidata && `https://www.wikidata.org/wiki/${bookLinks[id].wikidata}`].filter((url): url is string => Boolean(url));
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', '@id': listId, name: "Antonio's reading library", numberOfItems: books.length, itemListElement: books.map((book, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': 'Book', '@id': `${SITE.url}/collections/books#${book.id}`, name: book.title, author: book.author, url: `${SITE.url}/collections/books#${book.id}`, ...(sameAs(book.id).length ? { sameAs: sameAs(book.id) } : {}) } })) };
---
<Base title="Books — Collections" description="Antonio's reading library: books read, currently reading, to read, and abandoned. Search by title, author, subject, and reading status." collection mainEntity={listId} breadcrumbs={breadcrumbs('Books', '/collections/books', parent)} card={{ path: '/og/books.png', alt: "antoniwan.online / Collections: Books on my mind, Antonio's reading library, on the site's pink quasicrystal pattern." }}>
  <PageIntro label="Books" title="Books on my mind" parent={parent}>
    Some I've finished, some I return to, some are still waiting. Reading status doesn't tell you whether I own a copy.
  </PageIntro>
  <CollectionTabs current="books" />
  <ReadingNow />
  <section class="section bookshelf" aria-labelledby="book-catalogue-title">
    <div class="collection-section-heading"><div><h2 id="book-catalogue-title">The book list</h2><p>Every book in the library, A to Z.</p></div></div>
    <form class="book-filters book-filters--chips" id="book-filters" role="search" aria-label="Find a book" hidden>
      <label class="book-search">Search books<input id="book-search" name="q" type="search" placeholder="Title, author, or subject" aria-controls="book-list" autocomplete="off" /></label>
      <label>Subject<select id="book-subject" name="subject" aria-controls="book-list"><option value="">All subjects</option>{subjects.map(subject => <option value={subject}>{subject}</option>)}</select></label>
      <button type="reset" class="book-reset" {...cta('clear-filters')}>Clear filters</button>
      <fieldset class="status-chips"><legend>Reading status</legend>
        <label><input type="radio" name="status" value="" checked aria-controls="book-list" /><span>All {books.length}</span></label>
        {statusCounts.map(status => <label><input type="radio" name="status" value={status.value} aria-controls="book-list" /><span>{status.label} {status.count}</span></label>)}
      </fieldset>
    </form>
    <div class="book-results"><p id="book-results" role="status" aria-live="polite" aria-atomic="true">{books.length} books</p><span>Titles A–Z</span></div>
    <ul id="book-list" class="book-list" aria-label="Books">
      {books.map(book => <li class="book-entry" id={book.id} data-book data-title={book.title} data-author={book.author} data-status={book.readingStatus} data-subjects={JSON.stringify(book.subjects)}>
        <h3><a href={bookLinks[book.id]?.wikipedia ?? `#${book.id}`}>{book.title}</a></h3>
        <p class="book-author">{book.author}</p>
        <ul class="book-subjects" aria-label="Subjects">{book.subjects.map(subject => <li>{subject}</li>)}</ul>
        {book.readingStatus === 'read' ? <p class="visually-hidden">{readingStatusLabels.read}</p> : <p class="book-status" data-reading-status={book.readingStatus}>{readingStatusLabels[book.readingStatus]}</p>}
      </li>)}
    </ul>
    <div class="book-empty" id="book-empty" hidden><h2>No books match</h2><p>Try another title or author, or clear the filters.</p></div>
    <p class="section__footnote">A selected snapshot of my Panda inventory. Unknown ownership and reference use stay unrecorded. This catalogue shows neither personal ratings nor unverified rating averages. <a href="/collections/books.json">Download the public catalogue as JSON</a>.</p>
    <noscript><p>The complete catalogue is available above. Enable JavaScript to use the filters.</p></noscript>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#book-filters');
  const search = document.querySelector<HTMLInputElement>('#book-search');
  const statusInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="status"]')];
  const status = { get value() { return statusInputs.find(input => input.checked)?.value ?? ''; }, set value(next: string) { statusInputs.forEach(input => { input.checked = input.value === next; }); }, options: statusInputs };
  const subject = document.querySelector<HTMLSelectElement>('#book-subject');
  const results = document.querySelector('#book-results');
  const empty = document.querySelector<HTMLElement>('#book-empty');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-book]')];
  const normalize = (text: string) => text.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  if (form && search && statusInputs.length && subject && results && empty) {
    const update = () => {
      const terms = normalize(search.value).split(/\s+/).filter(Boolean);
      let count = 0;
      for (const row of rows) {
        const subjects = JSON.parse(row.dataset.subjects ?? '[]') as string[];
        const text = normalize([row.dataset.title, row.dataset.author, ...subjects].join(' '));
        row.hidden = !terms.every(term => text.includes(term)) || Boolean(status.value && row.dataset.status !== status.value) || Boolean(subject.value && !subjects.includes(subject.value));
        if (!row.hidden) count++;
      }
      results.textContent = count === rows.length ? `${count} books` : `${count} of ${rows.length} books`;
      empty.hidden = count > 0;
    };
    const restore = () => {
      const params = new URL(location.href).searchParams;
      search.value = params.get('q') ?? '';
      const legacyStatus = params.get('status') === 'in-progress' ? 'reading' : params.get('status') ?? '';
      status.value = [...status.options].some(option => option.value === legacyStatus) ? legacyStatus : '';
      const selectedSubject = params.get('subject') ?? params.get('shelf') ?? '';
      subject.value = [...subject.options].some(option => option.value === selectedSubject) ? selectedSubject : '';
      update();
    };
    const apply = () => {
      update();
      const url = new URL(location.href);
      url.searchParams.delete('shelf');
      for (const [name, value] of [['q', search.value.trim()], ['status', status.value], ['subject', subject.value]]) {
        if (value) url.searchParams.set(name, value);
        else url.searchParams.delete(name);
      }
      history.replaceState(history.state, '', url);
    };
    search.addEventListener('input', apply);
    statusInputs.forEach(input => input.addEventListener('change', apply));
    subject.addEventListener('change', apply);
    form.addEventListener('submit', event => { event.preventDefault(); apply(); });
    form.addEventListener('reset', () => requestAnimationFrame(apply));
    window.addEventListener('popstate', restore);
    restore();
    form.hidden = false;
  }
</script>
