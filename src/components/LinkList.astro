---
import type { LinkSection } from '../data/links';
import { icons } from '../data/icons';

interface Props {
  section: LinkSection;
}

const { section } = Astro.props;
const rel = (me?: boolean) => (me ? 'me' : undefined);
---

<section class:list={['section', 'section--split', `section--${section.id}`]} id={section.id} aria-labelledby={`${section.id}-title`}>
  <div class="section__heading">
    <h2 id={`${section.id}-title`}>{section.title}</h2>
  </div>
  <div class="section__body">
  {
    section.layout === 'icons' ? (
      <ul class="icons">
        {section.items.map((item) => (
          <li>
            <a href={item.href} rel={rel(item.me)} title={item.label}>
              {item.icon && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d={icons[item.icon]} />
                </svg>
              )}
              <span class="visually-hidden">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="links">
        {section.items.map((item) => (
          <li>
            <a class="link-card" href={item.href} rel={rel(item.me)}>
              <span class="link-card__body">
                <span class="link-card__title">{item.label}</span>
                {item.note && <span class="note">{item.note}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  </div>
</section>
