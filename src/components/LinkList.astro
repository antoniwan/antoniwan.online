---
import type { LinkSection } from '../data/links';
import { icons } from '../data/icons';

interface Props {
  section: LinkSection;
}

const { section } = Astro.props;
const rel = (me?: boolean) => (me ? 'me' : undefined);
---

<section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
  <h2 id={`${section.id}-title`}>{section.title}</h2>
  {
    section.layout === 'icons' ? (
      <ul class="icons">
        {section.items.map((item) => (
          <li>
            <a href={item.href} rel={rel(item.me)} title={item.label}>
              {item.icon && (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d={icons[item.icon]} />
                </svg>
              )}
              <span class="visually-hidden">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="links">
        {section.items.map((item) => (
          <li>
            <a href={item.href} rel={rel(item.me)}>
              {item.label}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>
    )
  }
</section>
