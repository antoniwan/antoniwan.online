---
import { cta } from '../utils/cta';
import { SITE } from '../config/site';
import ShaderBackdrop from './ShaderBackdrop.astro';

const tld = SITE.domain.slice(SITE.handle.length);
const year = new Date().getFullYear();
---

<footer class="footer">
  <ShaderBackdrop edge="top" />
  <div class="wrap">
    <div class="footer__identity">
      <a class="footer__brand" href="/">{SITE.handle}<span>{tld}</span></a>
      <p>From Puerto Rico, in Florida.</p>
      <p class="footer__copyright">© {year} {SITE.name}</p>
    </div>
    <ul>
      <li><a href={`mailto:${SITE.email}`} {...cta('email')}>{SITE.email}</a></li>
      <li><a href={SITE.company.url} {...cta('company')}>{SITE.company.name}</a></li>
      <li><a href="/llms.txt">llms.txt</a></li>
      <li><a href={SITE.repo} {...cta('source')}>Source</a></li>
      <li hidden data-motion-control><button type="button" class="motion-toggle" aria-pressed="false" {...cta('pause-animation')}>Pause animation</button></li>
    </ul>
  </div>
</footer>
