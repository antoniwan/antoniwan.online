---
import type { Note } from '../utils/notes';
import { formatDate } from '../utils/notes';
import { SITE } from '../config/site';

interface Props {
  notes: Note[];
  count: number;
}

const { notes, count } = Astro.props;
---

<div data-notes>
  {
    notes.length > 0 ? (
      <ul class="essays">
        {notes.map((note, index) => (
          <li>
            <a class="essay" href={note.url}>
              <span class="essay__meta">
                {index === 0 && <span class="essay__label">Latest essay</span>}
                <time datetime={note.date.toISOString()}>{formatDate(note.date)}</time>
              </span>
              <h3 class="essay__title">{note.title}</h3>
              {note.summary && <p>{note.summary}</p>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>
        The latest list could not be loaded when this page was built. Read the essays at{' '}
        <a href={SITE.notesUrl}>notes.antoniwan.online</a>.
      </p>
    )
  }
</div>

<script is:inline define:vars={{ feedUrl: SITE.notesLatest, count }}>
  // The list above is from the last build. Fetch the newest posts and redraw it
  // only if Notes has published since, so the list never needs a rebuild.
  (() => {
    const box = document.querySelector('[data-notes]');
    if (!box || !window.fetch) return;
    const shown = [...box.querySelectorAll('.essays a')].map((a) => a.href).join(' ');
    fetch(feedUrl)
      .then((response) => (response.ok ? response.json() : null))
      .then((feed) => {
        const items = (feed?.items ?? []).slice(0, count);
        if (!items.length || items.map((item) => item.url).join(' ') === shown) return;
        const list = document.createElement('ul');
        list.className = 'essays';
        for (const item of items) {
          const li = document.createElement('li');
          const meta = document.createElement('span');
          meta.className = 'essay__meta';
          if (!list.children.length) {
            const label = document.createElement('span');
            label.className = 'essay__label';
            label.textContent = 'Latest essay';
            meta.append(label);
          }
          const date = new Date(item.date_published);
          const time = document.createElement('time');
          time.dateTime = date.toISOString();
          time.textContent = date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          });
          const link = document.createElement('a');
          link.className = 'essay';
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener';
          const title = document.createElement('h3');
          title.className = 'essay__title';
          title.textContent = item.title;
          meta.append(time);
          link.append(meta, title);
          if (item.summary) {
            const summary = document.createElement('p');
            summary.textContent = item.summary;
            link.append(summary);
          }
          li.append(link);
          list.append(li);
        }
        box.replaceChildren(list);
      })
      .catch(() => {});
  })();
</script>
