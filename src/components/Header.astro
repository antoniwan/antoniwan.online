---
import { NAV, SITE } from '../config/site';
import ShaderBackdrop from './ShaderBackdrop.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href.startsWith('/') && path === href;
---

<header class="header">
  <ShaderBackdrop edge="bottom" />
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>{SITE.handle}</a>
    <nav class="nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
