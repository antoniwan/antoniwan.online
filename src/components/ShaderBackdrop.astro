---
interface Props { edge: 'top' | 'bottom' }
const { edge } = Astro.props;
---

<div class:list={['shader-backdrop', `shader-backdrop--${edge}`]} aria-hidden="true">
  <canvas data-quasicrystal></canvas>
</div>

<style>
  .shader-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 85% 20%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      radial-gradient(ellipse at 45% 90%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%);
  }
  .shader-backdrop--bottom { mask-image: linear-gradient(to bottom, #000 65%, transparent); }
  .shader-backdrop--top { mask-image: linear-gradient(to top, #000 65%, transparent); }
  canvas { display: block; width: 100%; height: 100%; opacity: 0; }
  canvas[data-ready] { opacity: 1; }
</style>

<script>
  // TypeScript keeps the WebGL lifecycle checked by the site's existing Astro tooling.
  const vertexSource = `attribute vec2 position; void main(){gl_Position=vec4(position,0.0,1.0);}`;
  const fragmentSource = `
    precision mediump float;
    uniform vec2 resolution;
    uniform vec2 surface;
    uniform float time;
    uniform vec3 paper;
    uniform vec3 blue;
    uniform vec3 comet;
    uniform vec2 trail[9];
    uniform vec2 emission;
    void main(){
      vec2 uv=gl_FragCoord.xy/resolution;
      vec3 color=paper;
      if(emission.x<0.5){
        vec2 p=(uv-0.5)*vec2(surface.x/surface.y,1.0);
        float t=time*0.14;
        float wave=0.0;
        for(int i=0;i<5;i++){
          float angle=float(i)*0.62831853+t*0.07;
          wave+=cos(dot(p,vec2(cos(angle),sin(angle)))*16.0+t*(float(i)*0.10+0.3));
        }
        float pattern=0.08+0.8*pow(0.5+0.5*cos(wave*2.0),8.0);
        float strength=pattern*0.34*(0.34+0.66*smoothstep(0.05,0.88,uv.x));
        color=mix(paper,blue,strength);
      }
      vec2 pixel=abs((uv-trail[0])*surface);
      float point=1.0-smoothstep(0.45,0.95,max(pixel.x,pixel.y));
      point=max(point,exp(-dot(pixel,pixel)/5.0)*0.28);
      float tail=0.0;
      for(int i=0;i<8;i++){
        vec2 a=(uv-trail[i])*surface;
        vec2 b=(trail[i+1]-trail[i])*surface;
        float along=clamp(dot(a,b)/max(dot(b,b),0.001),0.0,1.0);
        float distance=length(a-b*along);
        float fade=pow(1.0-(float(i)+along)/8.0,2.0);
        tail=max(tail,exp(-distance*distance)*fade*0.85);
      }
      float light=max(point,tail)*emission.y;
      gl_FragColor=emission.x<0.5 ? vec4(mix(color,comet,light),1.0) : vec4(comet*light,light);
    }`;

  type Point = [number, number];
  type Path = { points: Point[]; direction: number; travelled: number };
  type Pulse = Path & { born: number };
  type Renderer = Path & {
    canvas: HTMLCanvasElement;
    gl: WebGLRenderingContext;
    resolution: WebGLUniformLocation | null;
    surface: WebGLUniformLocation | null;
    time: WebGLUniformLocation | null;
    paper: WebGLUniformLocation | null;
    blue: WebGLUniformLocation | null;
    comet: WebGLUniformLocation | null;
    trail: WebGLUniformLocation | null;
    emission: WebGLUniformLocation | null;
    pulses: Pulse[];
    clock: number;
    nextBurst: number;
    seedBorn: number;
    seedIndex: number;
    width: number;
    height: number;
    coordinates: Float32Array;
  };

  // The bright curves occur where the shader's wave sum is zero (or another multiple of pi).
  function contour(point: Point, seconds: number) {
    let value = 0, x = 0, y = 0;
    const t = seconds * 0.14;
    for (let i = 0; i < 5; i++) {
      const angle = i * 0.62831853 + t * 0.07;
      const dx = Math.cos(angle), dy = Math.sin(angle);
      const phase = (point[0] * dx + point[1] * dy) * 16 + t * (i * 0.1 + 0.3);
      value += Math.cos(phase);
      const gradient = -16 * Math.sin(phase);
      x += gradient * dx; y += gradient * dy;
    }
    return { value, x, y };
  }

  function project(point: Point, seconds: number, iterations = 3): Point {
    let result: Point = [...point];
    for (let i = 0; i < iterations; i++) {
      const f = contour(result, seconds);
      const length = Math.hypot(f.x, f.y);
      if (length < 0.001 || Math.abs(f.value) < 0.0001) break;
      const step = Math.max(-0.04, Math.min(0.04, f.value / length));
      result = [result[0] - step * f.x / length, result[1] - step * f.y / length];
    }
    return result;
  }

  function movePath(path: Path, height: number, seconds: number, delta: number, speed: number) {
    // Reproject the trail so it stays on the same curve while the pattern itself changes.
    path.points = path.points.map(point => project(point, seconds));
    const previous = path.points[0];
    let head: Point = [...previous];
    const steps = Math.max(2, Math.ceil(speed * delta / 1.5));
    for (let i = 0; i < steps; i++) {
      const gradient = contour(head, seconds);
      const length = Math.hypot(gradient.x, gradient.y) || 1;
      const step = speed * delta / height / steps * path.direction;
      head = project([head[0] - gradient.y / length * step, head[1] + gradient.x / length * step], seconds);
    }
    path.travelled += Math.hypot(head[0] - previous[0], head[1] - previous[1]) * height;
    if (path.travelled >= 3) {
      path.points = [head, ...path.points.slice(0, 8)];
      path.travelled = 0;
    } else path.points[0] = head;
  }

  function seedPoint(width: number, height: number, seconds: number, index: number): Point {
    const aspect = width / height;
    for (let attempt = 0; attempt < 20; attempt++) {
      const x = (((index + attempt) * 0.61803398875 + 0.13) % 1 - 0.5) * aspect * 0.6;
      const point = project([x, Math.sin(index + attempt) * 0.08], seconds, 24);
      if (Math.abs(point[1]) < 0.18 && Math.abs(point[0]) < aspect / 2 - 0.15) return point;
    }
    return project([0, 0], seconds, 32);
  }

  function seedOpacity(renderer: Renderer) {
    const [x, y] = renderer.points[0];
    const edge = Math.min((0.35 - Math.abs(y)) / 0.12, (renderer.width / renderer.height / 2 - 0.15 - Math.abs(x)) / 0.2);
    return Math.max(0, Math.min(1, edge, (renderer.clock - renderer.seedBorn) / 0.4));
  }

  function reseed(renderer: Renderer) {
    const start = seedPoint(renderer.width, renderer.height, renderer.clock, renderer.seedIndex++);
    renderer.points = Array.from({ length: 9 }, () => [...start]);
    renderer.travelled = 0;
    renderer.seedBorn = renderer.clock;
    renderer.nextBurst = renderer.clock + 0.9;
  }

  function advance(renderer: Renderer, delta: number) {
    // Each backdrop keeps its own clock, so returning onscreen never jumps the comet.
    renderer.clock += delta;
    movePath(renderer, renderer.height, renderer.clock, delta, 28);
    const [x, y] = renderer.points[0];
    if (Math.abs(y) >= 0.35 || Math.abs(x) >= renderer.width / renderer.height / 2 - 0.15) reseed(renderer);
    renderer.pulses = renderer.pulses.filter(pulse => renderer.clock - pulse.born < 2.1);
    if (renderer.clock >= renderer.nextBurst && seedOpacity(renderer) > 0.5 && !renderer.pulses.length) {
      renderer.pulses = [-1, 1].map(direction => ({
        points: Array.from({ length: 9 }, () => [...renderer.points[0]] as Point),
        direction, travelled: 0, born: renderer.clock,
      }));
      renderer.nextBurst = renderer.clock + 5;
    }
    renderer.pulses.forEach(pulse => movePath(pulse, renderer.height, renderer.clock, delta, 75));
  }

  function startBackdrops() {
    const canvases = [...document.querySelectorAll<HTMLCanvasElement>('[data-quasicrystal]')];
    const control = document.querySelector<HTMLElement>('[data-motion-control]');
    const button = control?.querySelector('button');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData || !canvases.length) return;

    const renderers = new Map<HTMLCanvasElement, Renderer>();
    const unavailable = new Set<HTMLCanvasElement>();
    const visible = new Set<HTMLCanvasElement>();
    let paused = false;
    try { paused = localStorage.getItem('antoniwan-motion') === 'paused'; } catch { /* Storage is optional. */ }
    let frame = 0;
    let last = 0;
    let paper = [0, 0, 0];
    let blue = [0, 0, 0];
    let comet = [0, 0, 0];

    function updateColors() {
      const style = getComputedStyle(document.documentElement);
      const rgb = (name: string) => {
        const hex = style.getPropertyValue(name).trim().slice(1);
        return [0, 2, 4].map(offset => parseInt(hex.slice(offset, offset + 2), 16) / 255);
      };
      paper = rgb('--paper'); blue = rgb('--accent'); comet = rgb('--comet');
    }

    function prepare(canvas: HTMLCanvasElement): Renderer | undefined {
      if (renderers.has(canvas)) return renderers.get(canvas);
      if (unavailable.has(canvas) || reduced.matches) return;
      const gl = canvas.getContext('webgl', { antialias: false, depth: false, stencil: false, powerPreference: 'low-power' });
      if (!gl) { unavailable.add(canvas); return; }
      const program = gl.createProgram();
      if (!program) { unavailable.add(canvas); return; }
      const shaders: WebGLShader[] = [];
      for (const [type, source] of [[gl.VERTEX_SHADER, vertexSource], [gl.FRAGMENT_SHADER, fragmentSource]] as const) {
        const shader = gl.createShader(type);
        if (!shader) continue;
        gl.shaderSource(shader, source); gl.compileShader(shader); gl.attachShader(program, shader); shaders.push(shader);
      }
      gl.linkProgram(program);
      shaders.forEach(shader => gl.deleteShader(shader));
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
        gl.deleteProgram(program); unavailable.add(canvas); return;
      }
      gl.useProgram(program);
      const buffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const position = gl.getAttribLocation(program, 'position');
      gl.enableVertexAttribArray(position); gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
      const renderer: Renderer = {
        canvas, gl,
        resolution: gl.getUniformLocation(program, 'resolution'),
        surface: gl.getUniformLocation(program, 'surface'),
        time: gl.getUniformLocation(program, 'time'),
        paper: gl.getUniformLocation(program, 'paper'),
        blue: gl.getUniformLocation(program, 'blue'),
        comet: gl.getUniformLocation(program, 'comet'),
        trail: gl.getUniformLocation(program, 'trail[0]'),
        emission: gl.getUniformLocation(program, 'emission'),
        pulses: [], clock: 9, nextBurst: 10, seedBorn: 9, seedIndex: 0,
        points: [], direction: 1, travelled: 0, width: 0, height: 0, coordinates: new Float32Array(18),
      };
      renderers.set(canvas, renderer);
      if (control) control.hidden = false;
      canvas.dataset.ready = '';
      return renderer;
    }

    function resize(renderer: Renderer) {
      const { canvas, gl } = renderer;
      if (renderer.width !== canvas.clientWidth || renderer.height !== canvas.clientHeight) {
        renderer.width = canvas.clientWidth; renderer.height = canvas.clientHeight;
        renderer.pulses = [];
        reseed(renderer);
      }
      // Keep the drawing buffer small, even on high-density phones and wide monitors.
      const scale = Math.min(1, 1200 / canvas.clientWidth, 240 / canvas.clientHeight);
      const width = Math.max(1, Math.round(canvas.clientWidth * scale));
      const height = Math.max(1, Math.round(canvas.clientHeight * scale));
      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
      gl.viewport(0, 0, width, height);
      gl.uniform2f(renderer.resolution, width, height);
      gl.uniform2f(renderer.surface, canvas.clientWidth, canvas.clientHeight);
    }

    function uploadTrail(renderer: Renderer, points: Point[]) {
      points.forEach((point, index) => {
        renderer.coordinates[index * 2] = point[0] * renderer.height / renderer.width + 0.5;
        renderer.coordinates[index * 2 + 1] = point[1] + 0.5;
      });
      renderer.gl.uniform2fv(renderer.trail, renderer.coordinates);
    }

    function draw(renderer: Renderer) {
      const { gl } = renderer;
      gl.disable(gl.BLEND); gl.disable(gl.SCISSOR_TEST);
      gl.uniform1f(renderer.time, renderer.clock);
      gl.uniform3fv(renderer.paper, paper); gl.uniform3fv(renderer.blue, blue);
      gl.uniform3fv(renderer.comet, comet);
      gl.uniform2f(renderer.emission, 0, seedOpacity(renderer));
      uploadTrail(renderer, renderer.points);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      // Reuse the same program and canvas; only shade the small rectangle around each pulse.
      gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA); gl.enable(gl.SCISSOR_TEST);
      for (const pulse of renderer.pulses) {
        const age = renderer.clock - pulse.born;
        const opacity = Math.min(1, age / 0.08) * Math.min(1, (2.1 - age) / 0.6);
        uploadTrail(renderer, pulse.points);
        let left = 1, right = 0, bottom = 1, top = 0;
        for (let i = 0; i < 18; i += 2) {
          left = Math.min(left, renderer.coordinates[i]); right = Math.max(right, renderer.coordinates[i]);
          bottom = Math.min(bottom, renderer.coordinates[i + 1]); top = Math.max(top, renderer.coordinates[i + 1]);
        }
        const x = Math.max(0, Math.floor(left * renderer.canvas.width) - 3);
        const y = Math.max(0, Math.floor(bottom * renderer.canvas.height) - 3);
        const width = Math.min(renderer.canvas.width - x, Math.ceil(right * renderer.canvas.width) + 3 - x);
        const height = Math.min(renderer.canvas.height - y, Math.ceil(top * renderer.canvas.height) + 3 - y);
        if (width <= 0 || height <= 0) continue;
        gl.scissor(x, y, width, height);
        gl.uniform2f(renderer.emission, 1, opacity);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      }
      gl.disable(gl.BLEND); gl.disable(gl.SCISSOR_TEST);
    }

    function tick(now: number) {
      frame = 0;
      if (document.hidden || reduced.matches || paused || !visible.size) return;
      if (now - last >= 1000 / 24) {
        const delta = Math.min((now - last) / 1000, 0.1);
        last = now;
        visible.forEach(canvas => {
          const renderer = renderers.get(canvas);
          if (renderer) { advance(renderer, delta); draw(renderer); }
        });
      }
      frame = requestAnimationFrame(tick);
    }

    function refresh() {
      cancelAnimationFrame(frame); frame = 0;
      if (button) { button.textContent = paused ? 'Resume animation' : 'Pause animation'; button.setAttribute('aria-pressed', String(paused)); }
      if (control) control.hidden = reduced.matches || !renderers.size;
      if (document.hidden) return;
      updateColors();
      let active = false;
      visible.forEach(canvas => {
        if (reduced.matches) { delete canvas.dataset.ready; return; }
        const renderer = prepare(canvas);
        if (renderer) { resize(renderer); draw(renderer); canvas.dataset.ready = ''; active = true; }
      });
      if (active && !paused && !reduced.matches) { last = performance.now(); frame = requestAnimationFrame(tick); }
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const canvas = entry.target as HTMLCanvasElement;
        if (entry.isIntersecting) visible.add(canvas); else visible.delete(canvas);
      });
      refresh();
    });
    const sizeObserver = new ResizeObserver(refresh);
    canvases.forEach(canvas => {
      observer.observe(canvas); sizeObserver.observe(canvas);
      canvas.addEventListener('webglcontextlost', event => {
        event.preventDefault(); delete canvas.dataset.ready; renderers.delete(canvas); unavailable.add(canvas); refresh();
      });
      canvas.addEventListener('webglcontextrestored', () => { unavailable.delete(canvas); refresh(); });
    });
    button?.addEventListener('click', () => {
      paused = !paused;
      try { localStorage.setItem('antoniwan-motion', paused ? 'paused' : 'playing'); } catch { /* Storage is optional. */ }
      refresh();
    });
    reduced.addEventListener('change', refresh);
    dark.addEventListener('change', refresh);
    document.addEventListener('visibilitychange', refresh);
    new MutationObserver(refresh).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    refresh();
  }

  // Give page content and fonts priority over decorative graphics.
  if ('requestIdleCallback' in window) window.requestIdleCallback(startBackdrops, { timeout: 1500 });
  else setTimeout(startBackdrops, 100);
</script>
