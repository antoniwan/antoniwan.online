---
// The divider between sections: a thin slice of the header's pattern with one neuron in it.
// ShaderBackdrop's script draws it. Without WebGL or motion, a faded hairline stays.
---

<div class="seam" aria-hidden="true">
  <canvas data-quasicrystal data-seam></canvas>
</div>

<style>
  .seam {
    height: 4rem;
    margin-block: 1.25rem;
    background: linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat;
    mask-image: radial-gradient(closest-side, #000 45%, transparent);
  }
  canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 0.6s; }
  canvas[data-ready] { opacity: 1; }
  @media (min-width: 48rem) {
    .seam { margin-block: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas { transition: none; }
  }
</style>
