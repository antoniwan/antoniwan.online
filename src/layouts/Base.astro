---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE } from '../config/site';
import { sections } from '../data/links';
import type { Crumb } from '../utils/breadcrumbs';

interface Props {
  title?: string;
  description?: string;
  /** True on pages about Antonio himself (Home, About): marks them as his profile page. */
  profile?: boolean;
  noindex?: boolean;
  collection?: boolean;
  mainEntity?: string;
  /** A page's own share card in public/, with its alt text. Defaults to the portrait card. */
  card?: { path: string; alt: string };
  /** Trail from Home to this page (see utils/breadcrumbs). Becomes a BreadcrumbList. */
  breadcrumbs?: Crumb[];
  /** ISO date the page's content last changed. Leave out when there is no real date. */
  dateModified?: string;
}

const { title, description = SITE.description, profile = false, noindex = false, collection = false, mainEntity, breadcrumbs, dateModified, card } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} (${SITE.handle})`;
// build.format is 'file', so pathnames end in .html at build time; Vercel serves them without it.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
// A short hash of og.png in its URL makes link previews fetch the new card after a redraw.
const versioned = (path: string) => new URL(`${path}?v=${createHash('sha256').update(readFileSync(`public${path}`)).digest('hex').slice(0, 8)}`, SITE.url).href;
const portraitCard = versioned('/og.png');
const ogImage = card ? versioned(card.path) : portraitCard;
const ogImageAlt = card?.alt ?? `${SITE.domain}: ${SITE.name}, with his portrait. Builder. Father. Boricua.`;
const sameAs = sections
  .flatMap((section) => section.items)
  .filter((item) => item.me)
  .map((item) => item.href);

const person = {
  '@type': 'Person',
  '@id': SITE.personId,
  name: SITE.name,
  alternateName: [SITE.handle, SITE.plainName],
  url: SITE.url,
  email: SITE.email,
  image: { '@type': 'ImageObject', url: versioned(SITE.portraitImage), width: 800, height: 800, caption: SITE.portraitAlt },
  jobTitle: 'Technical Program Manager',
  worksFor: { '@type': 'Organization', name: 'Stanley Black & Decker', url: 'https://www.stanleyblackanddecker.com' },
  homeLocation: { '@type': 'State', name: 'Florida', sameAs: 'https://www.wikidata.org/wiki/Q812' },
  birthPlace: { '@type': 'Place', name: 'Puerto Rico', sameAs: 'https://www.wikidata.org/wiki/Q1183' },
  knowsLanguage: SITE.languages,
  knowsAbout: SITE.knowsAbout,
  alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.alumniOf.name, sameAs: SITE.alumniOf.wikidata },
  sameAs,
};
// On Home only: the site's name, which Google can show above its results.
const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: [SITE.handle, SITE.plainName],
  url: `${SITE.url}/`,
  inLanguage: 'en',
  publisher: { '@id': SITE.personId },
};
// The last crumb is this page, so it takes the canonical URL; the others resolve against the site.
const breadcrumbId = `${canonical}#breadcrumb`;
const breadcrumbList = breadcrumbs && {
  '@type': 'BreadcrumbList',
  '@id': breadcrumbId,
  itemListElement: breadcrumbs.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1, name: crumb.name, item: index === breadcrumbs.length - 1 ? canonical : new URL(crumb.href, SITE.url).href })),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(cleanPath === '/' ? [website] : []),
    {
      '@type': profile ? 'ProfilePage' : collection ? 'CollectionPage' : 'WebPage',
      '@id': canonical,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: 'en',
      ...(dateModified ? { dateModified } : {}),
      isPartOf: { '@id': website['@id'] },
      ...(breadcrumbList ? { breadcrumb: { '@id': breadcrumbId } } : {}),
      about: { '@id': SITE.personId },
      ...(profile ? { mainEntity: { '@id': SITE.personId } } : {}),
      ...(mainEntity ? { mainEntity: { '@id': mainEntity } } : {}),
    },
    ...(breadcrumbList ? [breadcrumbList] : []),
    person,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="describedby" href="/llms.txt" />
    {sameAs.map((href) => <link rel="me" href={href} />)}
    <meta name="theme-color" content="#fdfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1013" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/Chivo-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={profile ? 'profile' : 'website'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {profile && <meta property="profile:username" content={SITE.handle} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@antoniwan" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {
      SITE.umami.host && SITE.umami.websiteId && (
        <script is:inline defer src={`${SITE.umami.host}/p.js`} data-website-id={SITE.umami.websiteId} data-domains={SITE.domain} data-do-not-track="true" />
      )
    }
    <script is:inline>
      // The previous site on this domain registered a service worker. Remove it and its caches.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((list) => list.forEach((r) => r.unregister()));
        if ('caches' in window) caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <Analytics />
  </body>
</html>
