---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { sections } from '../data/links';

interface Props {
  title?: string;
  description?: string;
  /** True on pages about Antonio himself (Home, About): marks them as his profile page. */
  profile?: boolean;
}

const { title, description = SITE.description, profile = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} (${SITE.handle})`;
// build.format is 'file', so pathnames end in .html at build time; Vercel serves them without it.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
const sameAs = sections
  .flatMap((section) => section.items)
  .filter((item) => item.me)
  .map((item) => item.href);

const person = {
  '@type': 'Person',
  '@id': SITE.personId,
  name: SITE.name,
  alternateName: [SITE.handle, SITE.plainName],
  url: SITE.url,
  email: SITE.email,
  image: new URL('/og.png', SITE.url).href,
  jobTitle: 'Technical Program Manager',
  worksFor: { '@type': 'Organization', name: 'Stanley Black & Decker', url: 'https://www.stanleyblackanddecker.com' },
  homeLocation: { '@type': 'State', name: 'Florida', sameAs: 'https://www.wikidata.org/wiki/Q812' },
  birthPlace: { '@type': 'Place', name: 'Puerto Rico', sameAs: 'https://www.wikidata.org/wiki/Q1183' },
  sameAs,
};
// On Home only: the site's name, which Google can show above its results.
const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: [SITE.handle, SITE.plainName],
  url: `${SITE.url}/`,
  inLanguage: 'en',
  publisher: { '@id': SITE.personId },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(cleanPath === '/' ? [website] : []),
    ...(profile ? [{ '@type': 'ProfilePage', '@id': canonical, url: canonical, mainEntity: { '@id': SITE.personId } }] : []),
    person,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="describedby" href="/llms.txt" />
    {sameAs.map((href) => <link rel="me" href={href} />)}
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a1f" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/Chivo-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="profile:username" content={SITE.handle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@antoniwan" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // The previous site on this domain registered a service worker. Remove it and its caches.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((list) => list.forEach((r) => r.unregister()));
        if ('caches' in window) caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
